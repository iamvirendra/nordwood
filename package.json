{
  "name": "nordwood",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run sitemap",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run sitemap",
    "build": "vite build && node scripts/prerender-blog.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "oxlint",
    "check:images": "node scripts/verify-image-mappings.mjs",
    "check:seo": "node scripts/verify-blog-seo.mjs",
    "preview": "vite preview",
    "dev:client": "vite",
    "server:dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "setup:local": "node scripts/setup-local.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:migrate": "node server/migrate.js",
    "admin:create": "node server/admin.js",
    "test:server": "node --test server/test/*.test.js",
    "test": "node --test scripts/*.test.mjs server/test/*.test.js",
    "db:test:setup": "node scripts/setup-test-db.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "mariadb": "^3.5.4",
    "nodemailer": "^10.0.15",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
